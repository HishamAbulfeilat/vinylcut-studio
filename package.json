{
  "name": "vinylcut-studio",
  "description": "An original, open-source sign-making and vinyl cutting web and desktop app",
  "author": "VinylCut Studio contributors",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "pack": "npm run build && electron-builder --dir",
    "package": "npm run build && electron-builder",
    "build:desktop": "npm run build && electron-builder",
    "build:electron": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.vinylcutstudio.app",
    "productName": "VinylCut Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
